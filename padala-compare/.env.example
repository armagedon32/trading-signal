# ---- Site -----------------------------------------------------------------
SITE_NAME=PadalaCompare
# Public address of your site (no trailing slash). Used in links, sitemap, bot messages.
SITE_URL=http://localhost:8000

# ---- Your referral / affiliate links --------------------------------------
# Leave empty until you are accepted; the plain website is used meanwhile.
AFF_REMITLY=
AFF_WISE=
AFF_WORLDREMIT=
AFF_WESTERNUNION=
AFF_XOOM=
AFF_INSTAREM=
AFF_MONEYGRAM=
AFF_PAYPAL=
AFF_OFX=

# ---- Telegram bot (free, from @BotFather) ---------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- Security -------------------------------------------------------------
# Any long random text. Protects /admin/* and the Telegram webhook.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---- Tuning (optional) ----------------------------------------------------
QUOTE_TTL_SECONDS=600
HISTORY_TTL_SECONDS=3600
HTTP_TIMEOUT_SECONDS=8
# PADALA_DATA_DIR=/data   # set this on hosts that give you a persistent disk
